--// =====================================================
--// JUJUBOT v3
--// Fast + Smooth + Floating Stand
--// =====================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local Settings = {
    Owner = "OShisysj",

    -- HIGHER = FASTER
    FollowSpeed = 16,

    -- How high JujuBot floats
    FloatHeight = 4,

    -- Stops tiny jitter when already at target
    Deadzone = 0.15,
}

--==================================================
-- STATE
--==================================================

local summoned = false
local following = false
local positionMode = "Right"

local chatConnection = nil
local connectedOwner = nil

--==================================================
-- GET FUNCTIONS
--==================================================

local function getOwner()
    return Players:FindFirstChild(Settings.Owner)
end

local function getRoot(character)
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- POSITION SYSTEM
--==================================================

local function getOffset()

    if positionMode == "Left" then
        return Vector3.new(-5, Settings.FloatHeight, 0)

    elseif positionMode == "Right" then
        return Vector3.new(5, Settings.FloatHeight, 0)

    elseif positionMode == "Back" then
        return Vector3.new(0, Settings.FloatHeight, 6)

    elseif positionMode == "Under" then
        return Vector3.new(0, -4, 0)
    end

    return Vector3.new(5, Settings.FloatHeight, 0)
end

--==================================================
-- SUMMON
--==================================================

local function summonBot()

    local owner = getOwner()

    if not owner or not owner.Character then
        warn("JujuBot: Owner not found.")
        return
    end

    summoned = true
    following = true

    print("JujuBot summoned!")
end

--==================================================
-- STOP
--==================================================

local function stopBot()
    summoned = false
    following = false

    print("JujuBot stopped.")
end

--==================================================
-- FAST + SMOOTH FLOATING FOLLOW
--==================================================

RunService.RenderStepped:Connect(function(deltaTime)

    if not summoned or not following then
        return
    end

    local owner = getOwner()

    if not owner or not owner.Character then
        return
    end

    local myCharacter = LocalPlayer.Character

    if not myCharacter then
        return
    end

    local myRoot = getRoot(myCharacter)
    local ownerRoot = getRoot(owner.Character)

    if not myRoot or not ownerRoot then
        return
    end

    -- Get position relative to owner
    local targetPosition =
        (ownerRoot.CFrame * CFrame.new(getOffset())).Position

    local distance =
        (targetPosition - myRoot.Position).Magnitude

    -- Smooth but very fast interpolation
    if distance > Settings.Deadzone then

        local alpha = 1 - math.exp(
            -Settings.FollowSpeed * deltaTime
        )

        local newPosition =
            myRoot.Position:Lerp(
                targetPosition,
                alpha
            )

        -- Face the same direction as owner
        myRoot.CFrame = CFrame.lookAt(
            newPosition,
            newPosition + ownerRoot.CFrame.LookVector
        )
    end

end)

--==================================================
-- COMMANDS
--==================================================

local function handleCommand(message)

    message = message:lower()

    if message == "summon!" then

        summonBot()

    elseif message == "stop!" then

        stopBot()

    elseif message == "follow!" then

        summoned = true
        following = true

    elseif message == "left!" then

        positionMode = "Left"

    elseif message == "right!" then

        positionMode = "Right"

    elseif message == "back!" then

        positionMode = "Back"

    elseif message == "under!" then

        positionMode = "Under"

    end
end

--==================================================
-- OWNER CHAT
--==================================================

local function connectOwner()

    local owner = getOwner()

    if not owner then
        print("JujuBot waiting for owner...")
        return
    end

    if connectedOwner == owner then
        return
    end

    if chatConnection then
        chatConnection:Disconnect()
    end

    connectedOwner = owner

    chatConnection = owner.Chatted:Connect(function(message)
        handleCommand(message)
    end)

    print("JujuBot connected to: " .. owner.Name)
end

connectOwner()

Players.PlayerAdded:Connect(function(player)

    if player.Name == Settings.Owner then
        task.wait(1)
        connectOwner()
    end

end)

--==================================================
-- RESPAWN
--==================================================

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)

    if summoned then
        following = true
    end
end)

--==================================================
-- STARTUP
--==================================================

print("===================================")
print("         JUJUBOT v3 LOADED")
print("===================================")
print("Owner: " .. Settings.Owner)
print("Commands:")
print("summon!")
print("stop!")
print("follow!")
print("left!")
print("right!")
print("back!")
print("under!")
print("===================================")
