--==================================================
-- CHARACTER HELPERS
--==================================================
local function getHRP(player)
    return player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    return player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
end

local function getOffset()
    if Settings.Position == "Left" then return Vector3.new(-4, Settings.FloatHeight, 0)
    elseif Settings.Position == "Right" then return Vector3.new(4, Settings.FloatHeight, 0)
    elseif Settings.Position == "Back" then return Vector3.new(0, Settings.FloatHeight, 4)
    elseif Settings.Position == "Under" then return Vector3.new(0, -4, 0)
    end
    return Vector3.new(4, Settings.FloatHeight, 0)
end

local function findPlayer(name)
    name = tostring(name or ""):lower():gsub("%s+", "")
    if name == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower():sub(1, #name) == name or player.DisplayName:lower():sub(1, #name) == name then
            return player
        end
    end
    return nil
end

local function findOwner()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower() == Settings.Owner:lower() then return player end
    end
    return nil
end

--==================================================
-- WEAPON & ATTACK SYSTEM
--==================================================
local function equipTool()
    local humanoid = getHumanoid(StandPlayer)
    local char = StandPlayer.Character
    local backpack = StandPlayer:FindFirstChildOfClass("Backpack")
    
    local weaponName = Settings.Weapon == "Knife" and "[Knife]" or "Combat"
    local tool = (char and char:FindFirstChild(weaponName)) or (backpack and backpack:FindFirstChild(weaponName))
    
    if tool and humanoid and tool.Parent ~= char then
        humanoid:EquipTool(tool)
        task.wait(0.05)
    end
    return tool
end

local function chargeAttack(holdTime)
    local tool = equipTool()
    if not tool then return false end
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(holdTime or 0.6)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    return true
end

--==================================================
-- ADVANCED KNOCK & KO DETECTION
--==================================================
local function isKnocked(character)
    if not character then return true end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 5 then return true end

    local bodyEffects = character:FindFirstChild("BodyEffects")
    if bodyEffects then
        local ko = bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO")
        if ko and ko.Value == true then return true end
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        local animName = track.Name:lower()
        if animName:find("knock") or animName:find("ko") or animName:find("down") or animName:find("ragdoll") then
            return true
        end
    end
    return false
end

--==================================================
-- FOLLOW SYSTEM (SMOOTH VELOCITY)
--==================================================
RunService.Heartbeat:Connect(function()
    if not following or attacking then return end
    if not OwnerPlayer or OwnerPlayer.Parent ~= Players then return end

    local ownerHRP = getHRP(OwnerPlayer)
    local standHRP = getHRP(StandPlayer)
    if not ownerHRP or not standHRP then return end

    local offset = getOffset()
    local floatOffset = math.sin(time() * 3) * 0.6
    
    local targetPosition = (ownerHRP.CFrame * CFrame.new(offset.X, offset.Y + floatOffset, offset.Z)).Position
    local distance = (targetPosition - standHRP.Position).Magnitude

    if distance > 35 then
        standHRP.CFrame = CFrame.new(targetPosition, targetPosition + ownerHRP.CFrame.LookVector)
        standHRP.AssemblyLinearVelocity = Vector3.zero
        return
    end

    local direction = targetPosition - standHRP.Position
    standHRP.AssemblyLinearVelocity = direction * 12
    standHRP.CFrame = CFrame.new(standHRP.Position, standHRP.Position + ownerHRP.CFrame.LookVector)
end)

--==================================================
-- 10X FAST KNOCK ATTACK
--==================================================
local function knock(target)
    if attacking or not target or target == StandPlayer then return end
    attacking = true
    charging = false

    task.spawn(function()
        local success, err = pcall(function()
            local startTime = time()
            local mainEvent = ReplicatedStorage:FindFirstChild("MainEvent")

            while following and target and target.Parent == Players and target.Character do
                if time() - startTime >= 15 then break end

                local myHRP = getHRP(StandPlayer)
                local enemyHRP = getHRP(target)

                if not myHRP or not enemyHRP or isKnocked(target.Character) then
                    print("Target Knocked! Disengaging...")
                    break
                end

                local distance = (myHRP.Position - enemyHRP.Position).Magnitude

                if distance > 4 then
                    local direction = enemyHRP.Position - myHRP.Position
                    if direction.Magnitude > 0 then direction = direction.Unit end
                    myHRP.AssemblyLinearVelocity = direction * 300
                    myHRP.CFrame = CFrame.new(myHRP.Position, enemyHRP.Position)
                else
                    charging = true
                    myHRP.CFrame = enemyHRP.CFrame * CFrame.new(0, 0, 1.2)
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    
                    if mainEvent then mainEvent:FireServer("Melee", enemyHRP.Position) end
                    chargeAttack(0.5)
                    charging = false
                end
                task.wait()
            end
        end)
        
        local myHRP = getHRP(StandPlayer)
        if myHRP then
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end
        attacking = false
    end)
end

--==================================================
-- STOMP / KO
--==================================================
local function stomp(target)
    if not target then return end
    local targetHRP = getHRP(target)
    local standHRP = getHRP(StandPlayer)
    if not targetHRP or not standHRP then return end

    attacking = true
    pcall(function()
        standHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)
        task.wait(0.1)
        for _ = 1, 6 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.15)
        end
    end)
    attacking = false
end

--==================================================
-- COMMAND HANDLER
--==================================================
local function stopStand()
    following = false
    attacking = false
    charging = false
    local hrp = getHRP(StandPlayer)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    print("Stand stopped")
end

local function summon()
    following = true
    attacking = false
    charging = false
    local humanoid = getHumanoid(StandPlayer)
    if humanoid then humanoid.AutoRotate = false end
    print("Stand summoned")
end

local function onOwnerChatted(message)
    if typeof(message) ~= "string" then return end
    message = message:lower():gsub("!", "") -- Supports both "knock" and "knock!"
    local split = message:split(" ")
    local command = split[1]
    if not command then return end
    table.remove(split, 1)
    local arguments = table.concat(split, " ")

    if command == "summon" or command == "s" or command == "follow" then summon()
    elseif command == "stop" or command == "x" then stopStand()
    elseif command == "left" then Settings.Position = "Left"
    elseif command == "right" then Settings.Position = "Right"
    elseif command == "back" then Settings.Position = "Back"
    elseif command == "under" then Settings.Position = "Under"
    elseif command == "combat" then Settings.Weapon = "Combat"
    elseif command == "knife" then Settings.Weapon = "Knife"
    elseif command == "knock" or command == "k" then
        local target = findPlayer(arguments)
        if target then knock(target) else warn("Player not found") end
    elseif command == "ko" or command == "stomp" then
        local target = findPlayer(arguments)
        if target then task.spawn(stomp, target) end
    elseif message == "work now" then
        local tcs = TextChatService:FindFirstChild("TextChannels")
        if tcs then
            for _, c in ipairs(tcs:GetChildren()) do
                if c:IsA("TextChannel") then pcall(function() c:SendAsync("Yes master.") end) end
            end
        end
    end
end

