--// =====================================================
--// JUJUBOT v1
--// Clean Stand Follow System
--// Summon • Smooth Follow • Float • Positions
--// =====================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local Settings = {
    Owner = "Oshisysj",

    -- Follow smoothness
    Smoothness = 0.10,

    -- Floating settings
    FloatHeight = 2.5,
    FloatAmount = 0.35,
    FloatSpeed = 2,
}

--==================================================
-- STATE
--==================================================

local summoned = false
local following = false
local floating = true

local positionMode = "Right"

local currentCFrame = nil

--==================================================
-- GET PLAYER FUNCTIONS
--==================================================

local function getOwner()
    return Players:FindFirstChild(Settings.Owner)
end

local function getCharacter(player)
    if not player then
        return nil
    end

    return player.Character
end

local function getRoot(character)
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- POSITION SYSTEM
--==================================================

local function getOffset()

    if positionMode == "Left" then

        return Vector3.new(
            -5,
            Settings.FloatHeight,
            1
        )

    elseif positionMode == "Right" then

        return Vector3.new(
            5,
            Settings.FloatHeight,
            1
        )

    elseif positionMode == "Back" then

        return Vector3.new(
            0,
            Settings.FloatHeight,
            6
        )

    elseif positionMode == "Under" then

        return Vector3.new(
            0,
            -5,
            0
        )

    end

    return Vector3.new(
        5,
        Settings.FloatHeight,
        1
    )
end

--==================================================
-- STOP BOT
--==================================================

local function stopBot()

    summoned = false
    following = false

    currentCFrame = nil

    print("JujuBot stopped.")
end

--==================================================
-- SUMMON BOT
--==================================================

local function summonBot()

    local owner = getOwner()

    if not owner then

        warn(
            "JujuBot: Owner not found."
        )

        return
    end

    summoned = true
    following = true

    -- Start from current position
    if LocalPlayer.Character then

        local root = getRoot(
            LocalPlayer.Character
        )

        if root then
            currentCFrame = root.CFrame
        end
    end

    print("JujuBot summoned!")
end

--==================================================
-- SMOOTH FOLLOW SYSTEM
--==================================================

RunService.RenderStepped:Connect(function()

    if not summoned then
        return
    end

    if not following then
        return
    end

    local owner = getOwner()

    if not owner then
        return
    end

    local myCharacter =
        LocalPlayer.Character

    local ownerCharacter =
        owner.Character

    if not myCharacter then
        return
    end

    if not ownerCharacter then
        return
    end

    local myRoot =
        getRoot(myCharacter)

    local ownerRoot =
        getRoot(ownerCharacter)

    if not myRoot then
        return
    end

    if not ownerRoot then
        return
    end

    -- Get selected position
    local offset =
        getOffset()

    -- Position rotates with owner
    local targetPosition =
        (
            ownerRoot.CFrame
            * CFrame.new(offset)
        ).Position

    -- Floating animation
    if floating then

        local bob =
            math.sin(
                time()
                * Settings.FloatSpeed
            )
            * Settings.FloatAmount

        targetPosition =
            targetPosition
            + Vector3.new(
                0,
                bob,
                0
            )
    end

    -- Face the same direction as owner
    local targetCFrame =
        CFrame.new(
            targetPosition,
            targetPosition
            + ownerRoot.CFrame.LookVector
        )

    -- Setup smooth movement
    if not currentCFrame then

        currentCFrame =
            myRoot.CFrame

    end

    -- Smoothly move towards target
    currentCFrame =
        currentCFrame:Lerp(
            targetCFrame,
            Settings.Smoothness
        )

    myRoot.CFrame =
        currentCFrame

end)

--==================================================
-- COMMAND SYSTEM
--==================================================

local function handleCommand(message)

    message =
        message:lower()

    -- SUMMON
    if message == "summon!" then

        summonBot()

    -- STOP
    elseif message == "stop!" then

        stopBot()

    -- FOLLOW
    elseif message == "follow!" then

        summoned = true
        following = true

        print("JujuBot following.")

    -- LEFT
    elseif message == "left!" then

        positionMode = "Left"

        print(
            "JujuBot position: Left"
        )

    -- RIGHT
    elseif message == "right!" then

        positionMode = "Right"

        print(
            "JujuBot position: Right"
        )

    -- BACK
    elseif message == "back!" then

        positionMode = "Back"

        print(
            "JujuBot position: Back"
        )

    -- UNDER
    elseif message == "under!" then

        positionMode = "Under"

        print(
            "JujuBot position: Under"
        )

    -- FLOAT
    elseif message == "float!" then

        floating = true

        print(
            "JujuBot floating enabled."
        )

    -- LAND
    elseif message == "land!" then

        floating = false

        print(
            "JujuBot floating disabled."
        )

    end

end

--==================================================
-- CONNECT OWNER CHAT
--==================================================

local connectedOwner = nil
local chatConnection = nil

local function connectOwner()

    local owner =
        getOwner()

    if not owner then

        print(
            "JujuBot waiting for owner..."
        )

        return
    end

    -- Prevent duplicate connections
    if connectedOwner == owner then
        return
    end

    if chatConnection then

        chatConnection:Disconnect()

    end

    connectedOwner = owner

    chatConnection =
        owner.Chatted:Connect(
            function(message)

                handleCommand(
                    message
                )

            end
        )

    print(
        "JujuBot connected to: "
        .. owner.Name
    )

end

-- Try connecting immediately
connectOwner()

-- Connect if owner joins later
Players.PlayerAdded:Connect(
    function(player)

        if player.Name ==
            Settings.Owner
        then

            task.wait(1)

            connectOwner()

        end

    end
)

--==================================================
-- RESPAWN HANDLING
--==================================================

LocalPlayer.CharacterAdded:Connect(
    function(character)

        currentCFrame = nil

        task.wait(1)

        local root =
            getRoot(character)

        if root and summoned then

            currentCFrame =
                root.CFrame

        end

    end
)

