local summoned = false
local following = false
local targetKnockMode = false
local currentTarget = nil
local positionMode = Settings.Position

local chatConnection = nil
local connectedOwner = nil

local function getOwner()
    return Players:FindFirstChild(Settings.Owner)
end

local function getRoot(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getOffset()
    if positionMode == "Left" then
        return Vector3.new(-5, Settings.FloatHeight, 0)
    elseif positionMode == "Right" then
        return Vector3.new(5, Settings.FloatHeight, 0)
    elseif positionMode == "Back" then
        return Vector3.new(0, Settings.FloatHeight, 6)
    elseif positionMode == "Under" then
        return Vector3.new(0, -4, 0)
    end
    return Vector3.new(5, Settings.FloatHeight, 0)
end

local function summonBot()
    local owner = getOwner()
    if not owner or not owner.Character then
        warn("JujuBot: Owner not found.")
        return
    end
    targetKnockMode = false
    currentTarget = nil
    summoned = true
    following = true
    print("JujuBot summoned!")
end

local function stopBot()
    summoned = false
    following = false
    targetKnockMode = false
    currentTarget = nil
    print("JujuBot stopped.")
end

--==================================================
-- KO DETECTION & HIGH-SPEED TARGET TRACKING
--==================================================

local function getTargetPlayer(name)
    name = name:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and (player.Name:lower():sub(1, #name) == name or player.DisplayName:lower():sub(1, #name) == name) then
            return player
        end
    end
    return nil
end

-- Checks if the target is knocked out / downed
local function isTargetKnocked(target)
    if not target or not target.Character then return true end
    
    local char = target.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    -- Generic health check
    if hum and hum.Health <= 1 then return true end
    
    -- Da Hood specific BodyEffects KO check
    local bodyEffects = char:FindFirstChild("BodyEffects")
    if bodyEffects then
        local ko = bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO")
        if ko and ko.Value == true then
            return true
        end
    end
    
    -- Animation check for Downed / KO state
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            local animName = track.Name:lower()
            if animName:find("knock") or animName:find("ko") or animName:find("down") then
                return true
            end
        end
    end

    return false
end

-- Fast Knock Loop
local function KnockTarget(targetName)
    local target = getTargetPlayer(targetName)
    if not target or not target.Character then
        warn("JujuBot: Target player not found.")
        return
    end

    currentTarget = target
    targetKnockMode = true
    following = false -- Pause standard owner tracking

    print("JujuBot: Locking onto target -> " .. target.Name)

    task.spawn(function()
        local startTime = tick()
        
        while targetKnockMode and currentTarget == target do
            -- Safety Timeout (12 seconds) or KO Detection check
            if tick() - startTime > 12 or isTargetKnocked(target) then
                print("JujuBot: Target successfully knocked or timed out. Returning to owner.")
                break
            end

            local myChar = LocalPlayer.Character
            local targetChar = target.Character
            
            if myChar and targetChar then
                local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

                if myRoot and targetRoot then
                    -- Stick directly behind target
                    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.8)

                    -- Trigger attack tool
                    local weaponName = Settings.Weapon == "Knife" and "[Knife]" or "Combat"
                    local tool = myChar:FindFirstChild(weaponName) or LocalPlayer.Backpack:FindFirstChild(weaponName)
                    
                    if tool then
                        tool.Parent = myChar
                        tool:Activate()
                    end
                end
            end

            task.wait(0.03) -- High-frequency loop
        end

        -- Cleanup & return to owner
        targetKnockMode = false
        currentTarget = nil
        if summoned then
            following = true
        end
    end)
end

-- RenderStepped Main Stance & Standard Follow Loop
RunService.RenderStepped:Connect(function(deltaTime)
    if targetKnockMode or not summoned or not following then return end

    local owner = getOwner()
    if not owner or not owner.Character then return end

    local myCharacter = LocalPlayer.Character
    if not myCharacter then return end

    local myRoot = getRoot(myCharacter)
    local ownerRoot = getRoot(owner.Character)
    if not myRoot or not ownerRoot then return end

    local targetPosition = (ownerRoot.CFrame * CFrame.new(getOffset())).Position
    local distance = (targetPosition - myRoot.Position).Magnitude

    if distance > Settings.Deadzone then
        local alpha = 1 - math.exp(-Settings.FollowSpeed * deltaTime)
        local newPosition = myRoot.Position:Lerp(targetPosition, alpha)

        myRoot.CFrame = CFrame.lookAt(
            newPosition,
            newPosition + ownerRoot.CFrame.LookVector
        )
    end
end)

--==================================================
-- COMMAND HANDLER
--==================================================

local function handleCommand(message)
    local args = string.split(message, " ")
    local cmd = args[1]:lower()

    -- Movement Commands
    if cmd == "summon!" then
        summonBot()
    elseif cmd == "stop!" then
        stopBot()
    elseif cmd == "follow!" then
        targetKnockMode = false
        summoned = true
        following = true
    elseif cmd == "left!" then
        positionMode = "Left"
    elseif cmd == "right!" then
        positionMode = "Right"
    elseif cmd == "back!" then
        positionMode = "Back"
    elseif cmd == "under!" then
        positionMode = "Under"

    -- Weapon Mode Selectors
    elseif cmd == "combat!" then
        Settings.Weapon = "Combat"
        print("JujuBot: Set weapon to COMBAT")
    elseif cmd == "knife!" then
        Settings.Weapon = "Knife"
        print("JujuBot: Set weapon to KNIFE")

    -- Targeted Knock Command
    elseif (cmd == "knock!" or cmd == "knock") and args[2] then
        KnockTarget(args[2])
    end
end

local function connectOwner()
    local owner = getOwner()
    if not owner then
        print("JujuBot waiting for owner...")
        return
    end

    if connectedOwner == owner then return end

    if chatConnection then
        chatConnection:Disconnect()
    end

    connectedOwner = owner
    chatConnection = owner.Chatted:Connect(handleCommand)
    print("JujuBot connected to owner: " .. owner.Name)
end

