--// =====================================================
--// JUJUBOT v2
--// Smooth Stand Follow - No Floating/Jiggling
--// =====================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local Settings = {
    Owner = "OShisysj",

    -- Higher = catches up faster
    FollowSpeed = 8,

    -- How far away before JujuBot starts catching up
    Deadzone = 0.5,
}

--==================================================
-- STATE
--==================================================

local summoned = false
local following = false

local positionMode = "Right"
local chatConnection = nil
local connectedOwner = nil

--==================================================
-- GET FUNCTIONS
--==================================================

local function getOwner()
    return Players:FindFirstChild(Settings.Owner)
end

local function getRoot(character)
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- POSITION OFFSET
--==================================================

local function getOffset()

    if positionMode == "Left" then
        return Vector3.new(-5, 2.5, 1)

    elseif positionMode == "Right" then
        return Vector3.new(5, 2.5, 1)

    elseif positionMode == "Back" then
        return Vector3.new(0, 2.5, 6)

    elseif positionMode == "Under" then
        return Vector3.new(0, -5, 0)
    end

    return Vector3.new(5, 2.5, 1)
end

--==================================================
-- SUMMON
--==================================================

local function summonBot()

    local owner = getOwner()

    if not owner or not owner.Character then
        warn("JujuBot: Owner not found.")
        return
    end

    summoned = true
    following = true

    print("JujuBot summoned!")
end

--==================================================
-- STOP
--==================================================

local function stopBot()

    summoned = false
    following = false

    print("JujuBot stopped.")
end

--==================================================
-- SMOOTH FOLLOW
--==================================================

RunService.RenderStepped:Connect(function(deltaTime)

    if not summoned or not following then
        return
    end

    local owner = getOwner()

    if not owner then
        return
    end

    local myCharacter = LocalPlayer.Character
    local ownerCharacter = owner.Character

    if not myCharacter or not ownerCharacter then
        return
    end

    local myRoot = getRoot(myCharacter)
    local ownerRoot = getRoot(ownerCharacter)

    if not myRoot or not ownerRoot then
        return
    end

    -- Get the desired position around the owner
    local offset = getOffset()

    local targetPosition =
        (ownerRoot.CFrame * CFrame.new(offset)).Position

    -- Only move if we're far enough away
    local distance =
        (myRoot.Position - targetPosition).Magnitude

    if distance <= Settings.Deadzone then
        return
    end

    -- Frame-rate independent smoothing
    local alpha =
        1 - math.exp(
            -Settings.FollowSpeed * deltaTime
        )

    -- Smooth position
    local newPosition =
        myRoot.Position:Lerp(
            targetPosition,
            alpha
        )

    -- Face the same direction as owner
    local lookDirection =
        ownerRoot.CFrame.LookVector

    myRoot.CFrame =
        CFrame.lookAt(
            newPosition,
            newPosition + lookDirection
        )

end)

--==================================================
-- COMMANDS
--==================================================

local function handleCommand(message)

    message = message:lower()

    if message == "summon!" then

        summonBot()

    elseif message == "stop!" then

        stopBot()

    elseif message == "follow!" then

        summoned = true
        following = true

        print("JujuBot following.")

    elseif message == "left!" then

        positionMode = "Left"
        print("JujuBot: Left")

    elseif message == "right!" then

        positionMode = "Right"
        print("JujuBot: Right")

    elseif message == "back!" then

        positionMode = "Back"
        print("JujuBot: Back")

    elseif message == "under!" then

        positionMode = "Under"
        print("JujuBot: Under")

    end
end

--==================================================
-- OWNER CHAT
--==================================================

local function connectOwner()

    local owner = getOwner()

    if not owner then
        print("JujuBot waiting for owner...")
        return
    end

    if connectedOwner == owner then
        return
    end

    if chatConnection then
        chatConnection:Disconnect()
    end

    connectedOwner = owner

    chatConnection = owner.Chatted:Connect(function(message)
        handleCommand(message)
    end)

    print("JujuBot connected to: " .. owner.Name)
end

connectOwner()

Players.PlayerAdded:Connect(function(player)

    if player.Name == Settings.Owner then

        task.wait(1)

        connectOwner()
    end
end)

--==================================================
-- RESPAWN
--==================================================

LocalPlayer.CharacterAdded:Connect(function()

    task.wait(1)

    if summoned then
        following = true
    end
end)

--==================================================
-- STARTUP
--==================================================

print("===================================")
print("           JUJUBOT LOADED")
print("===================================")
print("Owner: " .. Settings.Owner)
print("")
print("COMMANDS:")
print("summon!")
print("stop!")
print("follow!")
print("left!")
print("right!")
print("back!")
print("under!")
print("===================================")
